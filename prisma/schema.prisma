// ViralPost AI — Prisma schema (SQLite)
// Domain model cloned from the reference app (viralpostai.base44.app):
// login users (creators / operators) and the contact-form inbox. The
// generator itself is stateless by design — the free quota is a
// client-side daily counter (the reference's own contract), rate-limited
// server-side per IP, so no Generation row is needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#14b8a6")
  photoUrl     String?
  role         String   @default("user") // user | admin
  // Email-verification funnel (ported from the template's battle-tested
  // shape): a NULL verificationExpiresAt means "no verification pending" —
  // the seeded demo user and every pre-verification account pass straight
  // through login. The code is stored HASHED (scrypt); the plaintext rides
  // only the in-app delivery payload (or a real mail transport).
  verificationCodeHash   String?
  verificationAttempts   Int      @default(0)
  verificationExpiresAt  DateTime?
  // Revocation dimension: every session token embeds the row's
  // tokenVersion at mint time; a password reset increments it and every
  // previously minted cookie dies at the getSessionUser comparison.
  tokenVersion Int @default(0)
  // Password-reset funnel: NULL resetToken means "no reset pending"; the
  // token is a 32-byte crypto-random hex consumed ATOMICALLY and
  // SINGLE-USE (the conditional updateMany carries token + live expiry in
  // its WHERE — a racing replay lands count 0 and answers the
  // invalid-token 400). 60-minute TTL. The column stores the SHA-256 hex
  // of the raw token (hashed-at-rest posture).
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The contact form's inbox. The reference's form is a client-side stub
// (zero network calls on submit — see docs/reference-investigation.md
// D-2); the clone persists the advertised action for real.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
