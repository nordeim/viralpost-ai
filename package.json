{
  "name": "viralpost-ai",
  "version": "1.0.0",
  "description": "ViralPost AI \u2014 Next.js 16 + React 19 + Prisma/SQLite AI social-post generator (clone of viralpostai.base44.app)",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && rm -f .next/standalone/.env",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint . --max-warnings 0",
    "db:push": "bun scripts/prisma-env.ts db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "bun prisma/seed.ts",
    "db:census": "bun scripts/census.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gate": "bun run lint && bun run typecheck && bun run test && bun run build && ./scripts/smoke-test.sh && CI=1 bun run test:e2e",
    "smoke": "./scripts/smoke-test.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "unrs-resolver",
    "prisma",
    "@prisma/client"
  ],
  "resolutions": {
    "zod": "4.6.7"
  }
}
