{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Session-174 (F-174b, the scaffold family's lesson): the
    // noImplicitAny: false escape hatch is RETIRED — full TS strictness.
    // (The flip surfaced stragglers in the family's scripts; this tree
    // was already clean at the session-1 graft.)
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // The scaffold family's session-24 (S24-P1) casing lesson, kept as
    // doctrine: TS1149 (not flag-controllable) fires when one program
    // includes two real files differing ONLY in casing — this repo's
    // capitalized routes (/Tool, /Pricing, /Contact) are safe because no
    // lowercase twin exists; never add one.
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "skills"
  ]
}
