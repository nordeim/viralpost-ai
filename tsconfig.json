{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Session-174 (F-174b, the scaffold family's lesson): the
    // noImplicitAny: false escape hatch is RETIRED — full TS strictness.
    // (The flip surfaced stragglers in the family's scripts; this tree
    // was already clean at the session-1 graft.)
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // The scaffold family's session-24 (S24-P1) casing lesson, kept as
    // doctrine: TS1149 (not flag-controllable) fires when one program
    // includes two real files differing ONLY in casing — this repo's
    // capitalized routes (/Tool, /Pricing, /Contact) are safe because no
    // lowercase twin exists; never add one.
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // Session-19 (S19-12): "**/*.mts" re-admits vitest.config.mts to the
  // program — the TS glob "**/*.ts" does NOT match .mts files, so the
  // session-18 S18-5 rename silently dropped the vitest config from
  // `tsc --noEmit` (verified live: --listFiles carried playwright.config.ts
  // but not the .mts; a type error there surfaced only as a Vite runtime
  // failure, never at the typecheck gate).
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "skills"
  ]
}
